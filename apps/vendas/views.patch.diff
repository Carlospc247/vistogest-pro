+def _associar_rascunho_fiscal(registo, documento, tipo_documento, usuario):
+    """Liga um rascunho existente ao registo comercial sem gerar outro documento fiscal."""
+    tipo = str(tipo_documento or '').strip().upper()
+    if documento.tipo_documento != tipo:
+        raise ValidationError(f'O rascunho é {documento.tipo_documento}, mas o registo exige {tipo}.')
+    if documento.status != 'draft':
+        raise ValidationError('O documento ligado já não está em rascunho.')
+    if documento.usuario_criacao_id != getattr(usuario, 'pk', None) and not getattr(usuario, 'is_superuser', False):
+        raise PermissionDenied('Este rascunho pertence a outro utilizador.')
+    if not hasattr(registo, 'documento_fiscal'):
+        raise ValidationError(f'{registo.__class__.__name__} não suporta ligação a DocumentoFiscal.')
+    actual_id = getattr(registo, 'documento_fiscal_id', None)
+    if actual_id and actual_id != documento.pk:
+        raise ValidationError('Este registo comercial já tem outro documento fiscal ligado.')
+
+    total_registo = getattr(registo, 'total', None)
+    if total_registo is not None and Decimal(str(total_registo or 0)) > Decimal('0.00'):
+        if not documento.linhas.exists():
+            raise ValidationError('O rascunho não contém linhas fiscais completas. Prima Ctrl+S novamente com os itens preenchidos antes de finalizar.')
+        if abs(Decimal(str(documento.valor_total or 0)) - Decimal(str(total_registo))) > CENTIMO:
+            raise ValidationError('Os totais do rascunho diferem dos totais comerciais. Guarde novamente o rascunho e tente finalizar.')
+
+    documento.metadados = dict(documento.metadados or {})
+    dados_rascunho = dict(documento.metadados.get('rascunho_documento') or {})
+    dados_rascunho['associado_em'] = timezone.now().isoformat()
+    dados_rascunho['registo_comercial'] = {
+        'modelo': registo.__class__.__name__,
+        'pk': registo.pk,
+    }
+    documento.metadados['rascunho_documento'] = dados_rascunho
+    documento.usuario_modificacao = usuario
+    documento.save()
+
+    registo.documento_fiscal = documento
+    fields_existentes = {campo.name for campo in registo._meta.concrete_fields}
+    update_fields = ['documento_fiscal']
+    for nome in ('numero_documento', 'numero_nota', 'numero_recibo', 'hash_documento', 'atcud'):
+        if nome in fields_existentes:
+            setattr(registo, nome, getattr(documento, nome) or None)
+            update_fields.append(nome)
+    if 'usuario_modificacao' in fields_existentes:
+        registo.usuario_modificacao = usuario
+        update_fields.append('usuario_modificacao')
+    if 'updated_at' in fields_existentes:
+        update_fields.append('updated_at')
+    try:
+        registo.save(update_fields=update_fields, criar_documento=False)
+    except TypeError as exc:
+        if 'criar_documento' not in str(exc):
+            raise
+        registo.save(update_fields=update_fields)
+    return documento
+
