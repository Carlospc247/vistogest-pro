+@transaction.atomic
+def _criar_rascunho_documento(tipo_documento, data, usuario, rascunho_id=None):
+    """Cria ou actualiza um DocumentoFiscal em draft, preservando os dados do formulário.
+
+    Este método nunca confirma, paga ou assina o documento. O mesmo rascunho pode
+    ser actualizado repetidamente por Ctrl+S e, ao finalizar, deve ser associado ao
+    registo comercial para evitar criar um segundo DocumentoFiscal.
+    """
+    tipo = str(tipo_documento or '').strip().upper()
+    tipos_validos = dict(DocumentoFiscal.TIPO_DOCUMENTO_CHOICES)
+    if tipo not in tipos_validos:
+        raise ValidationError(f'Tipo de documento fiscal inválido: {tipo or "não indicado"}.')
+
+    schema = getattr(connection, 'schema_name', 'public')
+    if not schema or schema == 'public':
+        raise ValidationError('Os rascunhos fiscais só podem ser guardados dentro do schema de um tenant.')
+
+    payload = _payload_rascunho_seguro(data)
+    cliente = _obter_cliente(data, obrigatorio=False) if data.get('cliente_id') else None
+    data_emissao = _data_rascunho_iso(data.get('data_emissao'), 'Data de emissão') or timezone.localdate()
+    data_vencimento = _data_rascunho_iso(data.get('data_vencimento') or data.get('data_validade'), 'Data de vencimento')
+    data_operacao = _data_rascunho_iso(data.get('data_operacao'), 'Data da operação')
+
+    tipo_cliente = str(data.get('tipo_cliente') or 'particular')
+    if tipo_cliente not in dict(DocumentoFiscal.TIPO_CLIENTE_CHOICES):
+        tipo_cliente = 'particular'
+
+    forma_nome = str(data.get('forma_pagamento_nome') or data.get('forma_pagamento') or '')
+    forma_id = data.get('forma_pagamento_id')
+    if forma_id:
+        forma_obj = FormaPagamento.objects.filter(pk=forma_id, ativa=True).first()
+        if forma_obj:
+            forma_nome = forma_obj.nome
+
+    # Tentar projectar linhas completas no modelo fiscal. Um rascunho pode estar
+    # incompleto; nesse caso o payload original continua guardado no metadados e
+    # as linhas fiscais serão reconstruídas na tentativa de finalização.
+    linhas_fiscais = None
+    itens = data.get('itens')
+    if isinstance(itens, list) and itens:
+        try:
+            linhas_normalizadas, _totais = _montar_linhas(itens, verificar_estoque=False)
+            construidas = []
+            for linha in linhas_normalizadas:
+                taxa = linha.get('taxa')
+                if taxa is None:
+                    raise ValidationError('Uma ou mais linhas não têm uma TaxaIVAAGT activa.')
+                produto = linha.get('produto')
+                servico = linha.get('servico')
+                codigo = (
+                    getattr(produto, 'codigo_produto', None)
+                    or getattr(produto, 'codigo_interno', None)
+                    or f'PROD-{produto.pk}'
+                ) if produto else (
+                    getattr(servico, 'codigo_servico', None)
+                    or getattr(servico, 'codigo_interno', None)
+                    or f'SRV-{servico.pk}'
+                )
+                unidade = getattr(produto, 'unidade', None) if produto else getattr(servico, 'unidade', None)
+                construidas.append({
+                    'produto': produto,
+                    'numero_linha': len(construidas) + 1,
+                    'codigo_produto': str(codigo)[:50],
+                    'descricao': str(linha.get('nome') or 'Item')[:200],
+                    'unidade': str(unidade or 'UN')[:10],
+                    'quantidade': linha['quantidade'],
+                    'preco_unitario': linha['preco'],
+                    'valor_desconto_linha': linha['desconto'],
+                    'taxa_iva': taxa,
+                    'operation_type': linha.get('operacao') or ('TB' if produto else 'SE'),
+                })
+            linhas_fiscais = construidas
+        except (ValidationError, TypeError, ValueError, KeyError) as exc:
+            # O objectivo do Ctrl+S é não perder um formulário ainda incompleto.
+            logger.debug('Rascunho %s guardado sem linhas fiscais completas: %s', tipo, exc)
+            linhas_fiscais = None
+
+    if rascunho_id:
+        try:
+            documento = DocumentoFiscal.objects.select_for_update().get(pk=rascunho_id)
+        except (DocumentoFiscal.DoesNotExist, ValueError, TypeError) as exc:
+            raise ValidationError('O rascunho indicado não existe neste tenant.') from exc
+        if documento.status != 'draft':
+            raise ValidationError('Só é possível actualizar documentos que ainda estejam em rascunho.')
+        if documento.tipo_documento != tipo:
+            raise ValidationError('O tipo do rascunho não corresponde ao tipo deste formulário.')
+        if documento.usuario_criacao_id != getattr(usuario, 'pk', None) and not getattr(usuario, 'is_superuser', False):
+            raise PermissionDenied('Este rascunho pertence a outro utilizador.')
+        schema_guardado = (documento.metadados or {}).get('rascunho_documento', {}).get('schema_name')
+        if schema_guardado and schema_guardado != schema:
+            raise PermissionDenied('Este rascunho pertence a outro tenant.')
+    else:
+        documento = DocumentoFiscal(
+            tipo_documento=tipo,
+            serie=str(data.get('serie') or 'A').strip()[:60] or 'A',
+            cliente=cliente,
+            data_emissao=data_emissao,
+            data_vencimento=data_vencimento,
+            data_operacao=data_operacao,
+            cliente_nome=(getattr(cliente, 'nome_completo', None) or getattr(cliente, 'razao_social', None) or str(cliente)) if cliente else 'Consumidor final',
+            tipo_cliente=tipo_cliente,
+            observacoes=str(data.get('observacoes') or '')[:10000],
+            condicoes_pagamento=str(data.get('condicoes_pagamento') or '')[:100],
+            forma_pagamento=forma_nome[:50],
+            moeda=str(data.get('moeda') or 'AOA').upper()[:3],
+            usuario_criacao=usuario,
+            origem='sistema',
+            status='draft',
+            metadados={},
+        )
+
+    # Actualizar apenas campos de cabeçalho que pertencem ao rascunho.
+    documento.cliente = cliente
+    documento.data_emissao = data_emissao
+    documento.data_vencimento = data_vencimento
+    documento.data_operacao = data_operacao
+    documento.tipo_cliente = tipo_cliente
+    documento.observacoes = str(data.get('observacoes') or '')[:10000]
+    documento.condicoes_pagamento = str(data.get('condicoes_pagamento') or '')[:100]
+    documento.forma_pagamento = forma_nome[:50]
+    documento.moeda = str(data.get('moeda') or 'AOA').upper()[:3]
+    documento.usuario_modificacao = usuario
+    documento.valor_base = Decimal('0.00')
+    documento.valor_iva = Decimal('0.00')
+    documento.valor_desconto = Decimal('0.00')
+    documento.valor_retencao = Decimal('0.00')
+    documento.valor_total = Decimal('0.00')
+
+    metadados = dict(documento.metadados or {})
+    metadados['rascunho_documento'] = {
+        'schema_name': schema,
+        'tipo_documento': tipo,
+        'actualizado_em': timezone.now().isoformat(),
+        'payload': payload,
+        'linhas_fiscais_completas': bool(linhas_fiscais),
+    }
+    documento.metadados = metadados
+
+    # Apaga/reconstrói as linhas só enquanto o documento é rascunho.
+    if documento.pk:
+        documento.linhas.all().delete()
+    documento.save()
+
+    if linhas_fiscais:
+        try:
+            with transaction.atomic():
+                objectos = [DocumentoFiscalLinha(documento=documento, **dados_linha) for dados_linha in linhas_fiscais]
+                for linha_fiscal in objectos:
+                    linha_fiscal.full_clean()
+                for linha_fiscal in objectos:
+                    linha_fiscal.save()
+        except (ValidationError, TypeError, ValueError) as exc:
+            logger.warning('Rascunho %s #%s mantido sem linhas fiscais; a validação será repetida ao finalizar: %s', tipo, documento.pk, exc)
+            documento.linhas.all().delete()
+            DocumentoFiscal.objects.filter(pk=documento.pk).update(
+                valor_base=Decimal('0.00'), valor_iva=Decimal('0.00'),
+                valor_desconto=Decimal('0.00'), valor_retencao=Decimal('0.00'),
+                valor_total=Decimal('0.00'),
+            )
+            documento.refresh_from_db()
+
+    documento.refresh_from_db()
+    return documento
+
