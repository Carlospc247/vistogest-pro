+@login_required
+@require_POST
+def guardar_rascunho_documento_api(request):
+    """Endpoint único usado pelo Ctrl+S em todos os formulários fiscais."""
+    try:
+        data = _ler_json(request)
+        _regime_do_tenant(request)
+        tipo = str(data.get('tipo_documento') or '').strip().upper()
+        acao = _RASCUNHO_ACAO_POR_TIPO.get(tipo)
+        if not acao:
+            raise ValidationError('Tipo de documento não suportado para rascunhos.')
+        funcionario = getattr(request.user, 'funcionario', None)
+        if not funcionario or not funcionario.pode_realizar_acao(acao):
+            raise PermissionDenied(f'Sem permissão para guardar rascunhos do tipo {tipo}.')
+
+        documento = _criar_rascunho_documento(
+            tipo, data, request.user, rascunho_id=data.get('rascunho_id') or None,
+        )
+        return JsonResponse({
+            'success': True,
+            'message': f'Rascunho {documento.numero_documento} guardado.',
+            'rascunho_id': documento.pk,
+            'numero_documento': documento.numero_documento,
+            'tipo_documento': documento.tipo_documento,
+            'status': documento.status,
+            'linhas_fiscais_completas': bool(documento.linhas.exists()) or not data.get('itens'),
+        })
+    except Exception as exc:
+        return _resposta_erro(exc)
