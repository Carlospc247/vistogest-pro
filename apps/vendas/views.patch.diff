+def _data_rascunho_iso(valor, campo, *, obrigatorio=False):
+    if valor in (None, ''):
+        if obrigatorio:
+            raise ValidationError(f'{campo} é obrigatória.')
+        return None
+    try:
+        return datetime.strptime(str(valor)[:10], '%Y-%m-%d').date()
+    except (TypeError, ValueError):
+        raise ValidationError(f'{campo} inválida. Use AAAA-MM-DD.')
+
+
+def _payload_rascunho_seguro(data):
+    """Guarda o payload do formulário para continuar depois; não guarda credenciais."""
+    if not isinstance(data, dict):
+        raise ValidationError('Dados do rascunho inválidos.')
+    # Estes campos não são dados de documento e não precisam de persistência.
+    payload = {k: v for k, v in data.items() if k not in {
+        'csrfmiddlewaretoken', 'password', 'senha', 'token', 'authorization'
+    }}
+    try:
+        bruto = json.dumps(payload, ensure_ascii=False, cls=DjangoJSONEncoder)
+    except (TypeError, ValueError) as exc:
+        raise ValidationError('Os dados do rascunho não são serializáveis.') from exc
+    if len(bruto.encode('utf-8')) > 500_000:
+        raise ValidationError('O rascunho excede o limite de 500 KB.')
+    return payload
+
