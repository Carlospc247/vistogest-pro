def _slugs(lista):
    """'apps.vendas' -> 'vendas'; junta core_tenants e remove repetidos."""
    out = ["core_tenants"]
    for item in lista:
        slug = item.split(".")[-1]
        if slug not in out:
            out.append(slug)
    return out


